{
  "name": "our-car-alive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy-pages.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "security:check": "node scripts/scan-secrets.mjs && node scripts/sync-headers.mjs --check && npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm test && npm run security:check"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wrangler": "^4.158.0"
  }
}
